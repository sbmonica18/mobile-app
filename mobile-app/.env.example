EXPO_PUBLIC_API_URL=http://192.168.1.18:8080/api

# Place photos: bundled local assets + free Wikipedia/Commons cache
# No Google Places key required for images.

# Optional — native Google Map tiles for production builds (Expo Go usually works without)
# Also paste the same key into app.json ios.config.googleMapsApiKey / android.config.googleMaps.apiKey
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Driving routes use free OSRM (no key). Google Maps deep link is used for turn-by-turn.
