{
  "name": "urbanlens",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --localhost --web",
    "start:phone": "expo start --lan --port 8081",
    "start:usb": "expo start --localhost --port 8081",
    "start:lan": "expo start --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --localhost --web",
    "build:apk": "eas build -p android --profile preview",
    "build:web": "expo export --platform web",
    "validate:images": "node scripts/validateDestinationImages.mjs",
    "validate:images:live": "node scripts/validateDestinationImages.mjs && node scripts/checkUnsplashUrls.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
